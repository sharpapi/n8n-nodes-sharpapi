{
  "name": "sharpapi-n8n",
  "private": true,
  "description": "Monorepo for the SharpAPI n8n community node packages",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sharpapi/n8n-nodes-sharpapi.git"
  },
  "engines": {
    "node": ">=22.22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup": "npm install --ignore-scripts",
    "sync": "node scripts/sync-shared.mjs",
    "typecheck": "npm run typecheck -ws",
    "lint": "npm run lint -ws",
    "build": "npm run build -ws",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.41.2",
    "@types/node": "^22.20.1",
    "n8n-workflow": "^2.16.0",
    "release-it": "^19.2.4",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
