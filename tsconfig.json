{
	"compilerOptions": {
		"strict": true,
		"module": "commonjs",
		"moduleResolution": "node",
		"target": "es2022",
		"lib": ["es2022", "dom"],
		"removeComments": true,
		"useUnknownInCatchVariables": false,
		"forceConsistentCasingInFileNames": true,
		"noImplicitAny": true,
		"noUnusedLocals": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"declaration": false,
		"sourceMap": false,
		"skipLibCheck": true,
		"outDir": "./dist/",
		"types": ["node"]
	},
	"include": ["credentials/**/*", "nodes/**/*"],
	"exclude": ["node_modules/**/*", "dist/**/*"]
}
